{
  "name": "t1d-server",
  "version": "1.0.0",
  "description": "AI-powered T1D/LADA management server",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "echo 'Build not needed - server runs directly from TypeScript'",
    "start": "node dist/index.js",
    "test": "tsx tests/run-tests.ts",
    "db:setup": "node scripts/setup-db.js",
    "db:reset": "node scripts/reset-db.js",
    "db:migrate": "node scripts/migrate-advanced-tracking.js && node scripts/migrate-pattern-detection.js && node scripts/migrate-reports.js",
    "db:migrate:push": "node scripts/run-migration.js",
    "check-config": "node scripts/check-config.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "setup": "npm install && npm run docker:up && sleep 5 && npm run db:setup",
    "reset": "npm run docker:up && sleep 5 && npm run db:reset",
    "full-start": "npm run docker:up && npm run dev"
  },
  "keywords": [
    "t1d",
    "diabetes",
    "ai",
    "health"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@langchain/community": "^0.0.32",
    "@langchain/core": "^1.1.18",
    "@langchain/langgraph": "^1.1.3",
    "@langchain/ollama": "^1.2.2",
    "@langchain/openai": "^1.2.4",
    "@types/compression": "^1.8.1",
    "@types/multer": "^2.0.0",
    "@types/xml2js": "^0.4.14",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "discord.js": "^14.25.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.1.25",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "pg": "^8.11.3",
    "puppeteer": "^19.11.1",
    "web-push": "^3.6.7",
    "xml2js": "^0.6.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
