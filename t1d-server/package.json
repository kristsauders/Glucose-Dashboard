{
  "name": "t1d-server",
  "version": "1.0.0",
  "description": "AI-powered T1D/LADA management server",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:setup": "node scripts/setup-db.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "setup": "npm install && npm run docker:up && sleep 5 && npm run db:setup",
    "full-start": "npm run docker:up && npm run dev"
  },
  "keywords": [
    "t1d",
    "diabetes",
    "ai",
    "health"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@langchain/community": "^0.0.32",
    "@langchain/core": "^1.1.18",
    "@langchain/langgraph": "^0.0.19",
    "@langchain/ollama": "^1.2.2",
    "@langchain/openai": "^0.0.14",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.1.25",
    "node-fetch": "^3.3.2",
    "pg": "^8.11.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
