# Server Configuration
PORT=3002
HTTP_PORT=3003  # Plain HTTP listener (for Apple Watch shortcuts that can't trust self-signed CA)
NODE_ENV=development

# Database
DATABASE_URL=postgresql://t1d_user:t1d_password_change_in_production@localhost:5432/t1d

# JWT Secret (generate a random string for production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# AI Provider (openrouter or ollama)
AI_PROVIDER=ollama

# OpenRouter (optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Ollama
OLLAMA_BASE_URL=http://192.168.202.132:11434
OLLAMA_MODEL=glm-4.7-flash:latest

# LibreView Polling
LIBREVIEW_POLL_INTERVAL=60000

# CORS - Frontend URL (where your React app is running)
# For local development: http://localhost:5173
# For production/Ubuntu: http://your-server-ip:5173
CORS_ORIGIN=http://localhost:5173

# Discord Webhook (optional - for proactive monitoring notifications)
DISCORD_WEBHOOK_URL=

# Discord Bot Token (optional - for two-way Discord chat)
DISCORD_BOT_TOKEN=
