# API Server URL (HTTPS when using local certs)
# For local development: http://localhost:3002
# For production: http://your-server-ip:3002 or https://your-domain.com
VITE_API_URL=http://localhost:3002

# Plain HTTP URL for clients that can't trust self-signed certs (e.g. Apple Watch shortcuts)
# Defaults to the same host as VITE_API_URL on port 3003 if not set
VITE_HTTP_API_URL=http://localhost:3003
